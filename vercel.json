{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 8 * * 1,4"
    },
    {
      "path": "/api/morning-sync",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "api/morning-sync.js": {
      "maxDuration": 300
    },
    "api/morning-webhook.js": {
      "maxDuration": 60
    },
    "api/sms-hook.js": {
      "maxDuration": 10
    },
    "api/driver-sign.js": {
      "maxDuration": 30
    },
    "api/link.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/ledger.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/tour.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/insights.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/driver",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/driver.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/delivery-core.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/driver",
      "destination": "/driver.html"
    }
  ]
}
